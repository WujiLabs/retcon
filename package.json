{
  "name": "@playtiss/retcon",
  "version": "0.6.1",
  "type": "module",
  "description": "Retcon for AI conversations. The AI recontextualizes its own past via MCP tools. Canonical Observer Actor instantiation of the Collaboration Protocol.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WujiLabs/retcon.git"
  },
  "homepage": "https://github.com/WujiLabs/retcon",
  "keywords": [
    "retcon",
    "playtiss",
    "claude",
    "claude-code",
    "mcp",
    "fork",
    "branch",
    "anthropic",
    "event-sourcing",
    "collaboration-protocol"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "retcon": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
    "prebuild": "npm run clean",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint --fix 'src/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@playtiss/core": "^0.3.0",
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "24.10.9",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
